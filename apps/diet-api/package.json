{
  "name": "@curseit/diet-api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "diet-api",
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            {
              "command": "tsc --noEmit -p apps/diet-api/tsconfig.app.json || true",
              "color": "red",
              "prefix": "typecheck: ",
              "prefixColor": "magenta"
            }
          ]
        },
        "dependsOn": ["build-deps"]
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "webpack-cli build",
          "args": [
            "node-env=production"
          ]
        },
        "configurations": {
          "development": {
            "args": [
              "node-env=development"
            ]
          },
          "e2e": {
            "args": [
              "node-env=e2e"
            ]
          }
        },
        "dependsOn": ["typecheck"]
      },
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build",
          "diet-orm:bootstrap"
        ],
        "options": {
          "buildTarget": "diet-api:build",
          "runBuildTargetDependencies": true
        },
        "configurations": {
          "development": {
            "buildTarget": "diet-api:build:development"
          },
          "production": {
            "buildTarget": "diet-api:build:production"
          },
          "e2e": {
            "buildTarget": "diet-api:build:e2e"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      }
    },
    "tags": [
      "server-side",
      "diet",
      "diet-api"
    ]
  }
}
