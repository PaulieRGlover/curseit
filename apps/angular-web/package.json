{
  "name": "angular-web",
  "version": "0.0.0",
  "private": true,
  "nx": {
    "name": "diet-web",
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "npm link ./dist/ciui",
            "npx ng build diet-web --stats-json"
          ],
          "cwd": "apps/angular-web",
          "parallel": false
        },
        "dependsOn": [
          "ciui-angular:build"
        ]
      },
      "serve": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "npm link ./dist/ciui",
            "npx ng serve diet-web"
          ],
          "cwd": "apps/angular-web",
          "parallel": false
        },
        "dependsOn": [
          "ciui-angular:serve"
        ]
      }
    }
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "ng-packagr": "^20.0.0",
    "typescript": "~5.8.2"
  }
}
