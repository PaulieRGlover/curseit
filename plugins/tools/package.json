{
  "name": "@curseit/tools",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "name": "tools",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "plugins/tools/dist",
          "main": "plugins/tools/src/index.ts",
          "tsConfig": "plugins/tools/tsconfig.lib.json",
          "rootDir": "plugins/tools/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./plugins/tools/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./plugins/tools/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "20.6.4",
    "tslib": "^2.3.0"
  },
  "executors": "./executors.json",
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "executors.json"
  ]
}
