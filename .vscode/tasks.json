{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "diet:db:down",
      "type": "shell",
      "command": "npx nx run diet-prisma:docker:down",
      "presentation": {
        "group": "diet",
        "panel": "new",
        "close": true
      }
    },
    {
      "label": "diet:db:up",
      "type": "shell",
      "command": "npx nx run diet-prisma:docker:up",
      "presentation": {
        "group": "diet",
        "panel": "new",
        "close": true
      }
    },
    {
      "label": "diet:db:migrate",
      "type": "shell",
      "command": "npx nx run diet-prisma:prisma:migrate:apply",
      "presentation": {
        "group": "diet",
        "panel": "new",
        "close": true
      }
    },
    {
      "label": "diet:db:create-client",
      "type": "shell",
      "command": "npx nx run diet-prisma:prisma:create-client",
      "presentation": {
        "group": "diet",
        "panel": "new",
        "close": true
      }
    },
    {
      "label": "diet:api:up",
      "type": "shell",
      "command": "npx nx serve diet-api --configuration=development",
      "presentation": {
        "group": "diet",
        "panel": "new"
      }
    },
    {
      "label": "diet:prisma-studio:up",
      "type": "shell",
      "command": "npx prisma studio --schema=libs/diet-prisma/src/schema.prisma",
      "dependsOn": ["Diet DB up"],
      "presentation": {
        "group": "diet",
        "panel": "new"
      }
    },
    {
      "label": "diet:services",
      "dependsOn": [
        "diet:api:up",
        "diet:prisma-studio:up"
      ],
      "dependsOrder": "parallel",
      "promptOnClose": true
    },
    {
      "label": "diet:dev:start",
      "dependsOn": [
        "diet:db:up",
        "diet:services"
      ],
      "dependsOrder": "sequence",
      "promptOnClose": true
    },
    {
      "label": "diet:dev:reset",
      "dependsOn": [
        "diet:db:down",
        "diet:db:up",
        "diet:db:migrate",
        "diet:db:create-client",
        "diet:services"
      ],
      "dependsOrder": "sequence",
      "promptOnClose": true
    }
  ]
}
