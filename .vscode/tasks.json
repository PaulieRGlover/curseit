{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "@diet:db:down",
      "type": "shell",
      "command": "npx nx run diet-orm:docker:down",
      "presentation": {
        "group": "diet",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "@diet:db:up",
      "type": "shell",
      "command": "npx nx run diet-orm:docker:up",
      "presentation": {
        "group": "diet",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "@diet:db:migrate:dev",
      "type": "shell",
      "command": "npx nx run diet-orm:prisma:migrate:dev",
      "presentation": {
        "group": "diet",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "@diet:db:migrate:apply",
      "type": "shell",
      "command": "npx nx run diet-orm:prisma:migrate:apply",
      "presentation": {
        "group": "diet",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "@diet:db:create-client",
      "type": "shell",
      "command": "npx nx run diet-orm:prisma:create-client",
      "presentation": {
        "group": "diet",
        "panel": "shared",
        "close": true
      }
    },
    {
      "label": "@diet:api:up",
      "type": "shell",
      "command": "npx nx serve diet-api --configuration=development",
      "presentation": {
        "group": "@diet:api",
        "panel": "new"
      }
    },
    {
      "label": "@diet:prisma-studio:up",
      "type": "shell",
      "command": "npx prisma studio --schema=libs/diet-orm/src/schema.prisma",
      "dependsOn": ["Diet DB up"],
      "presentation": {
        "group": "@diet:prisma-studio",
        "panel": "new"
      }
    },
    {
      "label": "@diet:services",
      "dependsOn": [
        "@diet:prisma-studio:up",
        "@diet:api:up"
      ],
      "dependsOrder": "parallel"
    },
    {
      "label": "@diet:dev:start",
      "dependsOn": [
        "@diet:db:up",
        "@diet:services"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "@diet:dev:update-db",
      "dependsOn": [
        "@diet:db:migrate:dev",
        "@diet:db:migrate:apply",
        "@diet:db:create-client"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "@diet:dev:reset",
      "dependsOn": [
        "@diet:db:down",
        "@diet:db:up",
        "@diet:db:migrate:dev",
        "@diet:db:migrate:apply",
        "@diet:db:create-client",
        "@diet:services"
      ],
      "dependsOrder": "sequence"
    }
  ]
}
