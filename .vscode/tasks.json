{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Diet DB up",
      "type": "shell",
      "command": "npx nx run diet-prisma:docker",
      "presentation": {
        "group": "cursediet",
        "panel": "new"
      }
    },
    {
      "label": "Diet API up",
      "type": "shell",
      "command": "npx nx serve diet-api --configuration=development"
    },
    {
      "label": "Prisma studio up",
      "type": "shell",
      "command": "npx prisma studio --schema=libs/diet-prisma/src/schema.prisma",
      "dependsOn": ["Foods DB up"]
    },
    {
      "label": "Start Diet Dev Enviroment",
      "dependsOn": [
        "Diet DB up",
        "Diet API up",
        "Prisma studio up"
      ],
      "dependsOrder": "parallel",
      "promptOnClose": true
    }
  ]
}
