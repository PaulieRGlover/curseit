{
  "name": "@curseit/diet-prisma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.ts",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "diet-prisma",
    "tags": [
      "diet-api",
      "diet"
    ]
  },
  "prisma": {
    "schema": "src/schema.prisma",
    "seed": "node --import tsx src/seed/index.ts src/seed/index.ts"
  },
  "scripts": {
    "docker": "docker compose -f tools/foods.docker-compose.yml up foods-db-dev pgadmin -d",
    "migrate:reset": "npx prisma migrate reset",
    "migrate:dev": "npx prisma migrate dev",
    "migrate:apply": "npx prisma db push",
    "create-client": "npx prisma generate",
    "seed": "npx prisma db seed"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
