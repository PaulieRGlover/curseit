{
  "name": "@curseit/diet-orm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "tags": [
      "diet-api",
      "diet"
    ],
    "name": "diet-orm"
  },
  "prisma": {
    "schema": "src/schema.prisma",
    "seed": "node --import tsx src/seed/index.ts src/seed/index.ts"
  },
  "scripts": {
    "docker:up": "docker compose -f tools/diet.docker-compose.yml up diet-db-dev pgadmin -d",
    "docker:down": "docker compose -f tools/diet.docker-compose.yml down -v",
    "prisma:migrate:reset": "npx prisma migrate reset",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:migrate:apply": "npx prisma db push",
    "prisma:create-client": "npx prisma generate",
    "prisma:seed": "npx prisma db seed"
  },
  "devDependencies": {
    "tslib": "^2.3.0",
    "@types/node": "^22.14.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
