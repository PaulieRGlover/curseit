// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../dist"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  login        String  @unique
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  passwordHash String  @map("password_hash")

  foods     Food[]
  nutrients UsersNutrient[]

  @@map("users")
}

model InvalidatedToken {
  id        String   @id
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("invalidated_tokens")
}

model Food {
  id          String  @id @default(uuid())
  name        String  @default("")
  description String  @default("")
  favorite    Boolean @default(false)
  perishable  Boolean @default(true)
  picture     String?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String          @map("user_id")
  variations FoodVariation[]

  @@map("foods")
}

model Nutrient {
  id             String  @id @default(uuid())
  name           String  @unique
  shortName      String? @map("short_name")
  description    String?
  externalId     String? @map("external_id")
  externalWeight Int?    @map("external_weight")

  foodVariations NutrientInFoodVariation[]
  customForUsers UsersNutrient[]

  @@map("nutrients")
}

model UsersNutrient {
  name String

  user       User     @relation(fields: [userId], references: [id])
  userId     String   @map("user_id")
  nutrient   Nutrient @relation(fields: [nutrientId], references: [id])
  nutrientId String   @map("nutrient_id")

  @@id([userId, nutrientId])
  @@map("users_nutrients")
}

model FoodVariation {
  id                       String   @id @default(uuid())
  name                     String
  counter                  String   @default("🥫")
  referenceSizeInGrams     Float    @default(100) @map("reference_size_in_grams")
  referenceSizeDisplayUnit FoodUnit @default(g) @map("reference_size_display_unit")
  portionSizeInGrams       Float    @default(100) @map("portion_size_in_grams")
  portionSizeDisplayUnit   FoodUnit @default(g) @map("portion_size_display_unit")
  energyAuto               Boolean  @default(true) @map("energy_auto")
  energyAmountInKcal       Float?   @map("energy_amount_in_kcal")
  energyDisplayUnit        Energy   @default(kcal) @map("energy_display_unit")
  provider                 String?
  providerId               String?  @map("provider_id")

  food      Food                      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  foodId    String                    @map("food_id")
  portions  FoodPortion[]
  nutrients NutrientInFoodVariation[]

  @@unique([name, foodId])
  @@map("food_variations")
}

model NutrientInFoodVariation {
  id               String       @id @default(uuid())
  valueInGrams     Float        @map("value_in_grams")
  valueDisplayUnit NutrientUnit @default(g) @map("value_display_unit")
  dateAdded        DateTime     @default(now()) @map("date_added")

  foodVariation   FoodVariation @relation(fields: [foodVariationId], references: [id], onDelete: Cascade)
  foodVariationId String        @map("food_variation_id")
  nutrient        Nutrient      @relation(fields: [nutrientId], references: [id], onDelete: Cascade)
  nutrientId      String        @map("nutrient_id")

  @@map("nutrients_in_food_variations")
}

model FoodPortion {
  id              String   @id
  dateAdded       DateTime @default(now()) @map("date_added")
  dateExpiring    DateTime @map("date_expiring")
  sizeInGrams     Float    @map("size_in_grams")
  sizeDisplayUnit FoodUnit @default(g) @map("size_display_unit")

  foodVariation   FoodVariation @relation(fields: [foodVariationId], references: [id], onDelete: Cascade)
  foodVariationId String        @map("food_variation_id")

  @@map("food_portions")
}

enum NutrientUnit {
  µg
  mg
  g
}

enum FoodUnit {
  mg
  g
  kg
  oz
  lb
}

enum Energy {
  kJ
  kcal
}
