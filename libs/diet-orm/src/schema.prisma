// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../dist"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  login        String  @unique
  firstName    String? @map("first_name")
  lastName     String? @map("last_name")
  passwordHash String  @map("password_hash")

  foods Food[]

  @@map("users")
}

model InvalidatedToken {
  id        String   @id
  expiresAt DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("invalidated_tokens")
}

model Food {
  id          String  @id @default(uuid())
  name        String  @unique
  counter     String  @default("🥫")
  description String?
  favorite    Boolean
  perishable  Boolean @default(true)
  picture     String?

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String          @map("user_id")
  variations FoodVariation[]

  @@map("foods")
}

model Nutrient {
  id   String @id @default(uuid())
  name String @unique

  foodVariations NutrientInFoodVariation[]

  @@map("nutrients")
}

model FoodVariation {
  id                       String  @id
  name                     String  @unique
  referenceSizeInGrams     Float   @default(100) @map("reference_size_in_grams")
  referenceSizeDisplayUnit String  @default("g") @map("reference_size_display_unit")
  portionSizeInGrams       Float   @default(100) @map("portion_size_in_grams")
  portionSizeDisplayUnit   String  @default("g") @map("portion_size_display_unit")
  energyAuto               Boolean @default(true) @map("energy_auto")
  provider                 String?
  providerId               String? @map("provider_id")

  food      Food                      @relation(fields: [foodId], references: [id])
  foodId    String
  portions  FoodPortion[]
  nutrients NutrientInFoodVariation[]

  @@map("food_variations")
}

model NutrientInFoodVariation {
  valueInGrams     Float  @map("value_in_grams")
  valueDisplayUnit String @default("g") @map("value_display_unit")

  foodVariation   FoodVariation @relation(fields: [foodVariationId], references: [id], onDelete: Cascade)
  foodVariationId String        @map("food_variation_id")
  nutrient        Nutrient      @relation(fields: [nutrientId], references: [id], onDelete: Cascade)
  nutrientId      String        @map("nutrient_id")

  @@id([foodVariationId, nutrientId])
  @@map("nutrients_in_food_variations")
}

model FoodPortion {
  id              String   @id
  timeAdded       DateTime @default(now()) @map("time_added")
  timeExpiring    DateTime @map("time_expiring")
  sizeInGrams     Float    @map("size_in_grams")
  sizeDisplayUnit String   @map("size_display_unit")

  foodVariation   FoodVariation @relation(fields: [foodVariationId], references: [id], onDelete: Cascade)
  foodVariationId String        @map("food_variation_id")

  @@map("food_portions")
}
