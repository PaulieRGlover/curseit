generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Food {
  id   String @id @default(uuid())
  name String @unique

  nutritients NutritientInFood[]

  @@map("foods")
}

model Nutritient {
  id   String @id @default(uuid())
  name String @unique
  norm Float

  foods NutritientInFood[]

  @@map("nutritients")
}

model NutritientInFood {
  value Float

  food         Food       @relation(fields: [foodId], references: [id])
  foodId       String
  nutritient   Nutritient @relation(fields: [nutritientId], references: [id])
  nutritientId String

  @@id([foodId, nutritientId])
  @@map("nutritients_in_food")
}
