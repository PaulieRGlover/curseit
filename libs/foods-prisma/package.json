{
  "name": "@curseit/foods-prisma",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "foods-prisma"
  },
  "dependencies": {},
  "prisma": {
    "schema": "src/schema.prisma"
  },
  "scripts": {
    "docker": "sudo docker compose -f tools/foods.docker-compose.yml up foods-db-dev pgadmin -d",
    "migrate:reset": "npx prisma migrate reset",
    "migrate:dev": "npx prisma migrate dev",
    "create-client": "npx prisma generate"
  }
}
